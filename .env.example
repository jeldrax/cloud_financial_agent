# ============================================
# Configuracion del Agente Financiero (Hermes)
# ============================================

# Telegram Bot (Obtener con @BotFather y @userinfobot)
TELEGRAM_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_numerico_aqui

# Google Gemini API (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash

# Ingesta de Correo Bancario (IMAP - Gmail requiere Contrasena de Aplicacion)
IMAP_USER=tu_correo@gmail.com
IMAP_PASSWORD=tu_contrasena_de_aplicacion
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=Banca_Agente
IMAP_CHECK_INTERVAL_MINUTES=5

# Configuracion Regional (es / en)
DEFAULT_LANG=es
