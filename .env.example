# ============================================
# Configuración del Agente Financiero (Hermes)
# ============================================

# 🤖 Telegram Bot (Obtener con @BotFather y @userinfobot)
TELEGRAM_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_numerico_aqui

# 🧠 Google Gemini API (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# 📬 Ingesta de Correo Bancario (IMAP - Gmail requiere Contraseña de Aplicación)
IMAP_USER=tu_correo@gmail.com
IMAP_PASSWORD=tu_contraseña_de_aplicacion
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=Banca_Agente
IMAP_CHECK_INTERVAL_MINUTES=5

# 🌐 Configuración Regional
DEFAULT_LANG=es
