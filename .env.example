# ============================================
# Configuracion del Agente Financiero (Hermes)
# Modo 100% Manual Zero-Trust (Sin Bancos/IMAP)
# ============================================

# Telegram Bot (Opcional - Obtener con @BotFather y @userinfobot)
TELEGRAM_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_numerico_aqui

# Google Gemini API (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# Presupuesto Base Mensual Inicial (Regla 50/30/20)
MONTHLY_INCOME=2400.0

# Configuracion Regional (es / en)
DEFAULT_LANG=es

# Frontend Multiplataforma Flutter (Zero-Trust / Envied via Tailscale)
API_URL=http://nombre-de-tu-servidor.tailnet:8000
API_TOKEN=reemplazar_con_token_secreto_de_alta_entropia
